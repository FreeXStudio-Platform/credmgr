#!/usr/bin/env node
'use strict';

// Ensure homebrew binaries are on PATH (age, age-keygen)
if (!process.env.PATH.includes('/opt/homebrew/bin')) {
  process.env.PATH = '/opt/homebrew/bin:' + process.env.PATH;
}

const path = require('path');
const fs = require('fs');
const readline = require('readline');

// Resolve lib relative to this script
const LIB = path.resolve(__dirname, '..', 'lib');
const cryptoLib = require(path.join(LIB, 'crypto'));
const store = require(path.join(LIB, 'store'));
const changelog = require(path.join(LIB, 'changelog'));
const { classify } = require(path.join(LIB, 'classify'));

// ─── Argument Parsing ───────────────────────────────────────────────────────

const args = process.argv.slice(2);
const command = args[0];

function getFlag(name) {
  const prefix = '--' + name + '=';
  const arg = args.find(a => a.startsWith(prefix));
  return arg ? arg.slice(prefix.length) : null;
}

function hasFlag(name) {
  return args.includes('--' + name);
}

// ─── Commands ───────────────────────────────────────────────────────────────

async function main() {
  switch (command) {
    case 'init':      return cmdInit();
    case 'get':       return cmdGet();
    case 'set':       return cmdSet();
    case 'rm':
    case 'remove':
    case 'delete':    return cmdRemove();
    case 'list':
    case 'ls':        return cmdList();
    case 'search':    return cmdSearch();
    case 'show':      return cmdShow();
    case 'export':    return cmdExport();
    case 'env':       return cmdEnv();
    case 'rotate':    return cmdRotate();
    case 'generate':
    case 'gen':       return cmdGenerate();
    case 'import':    return cmdImport();
    case 'batch':     return cmdBatch();
    case 'history':   return cmdHistory();
    case 'changelog': return cmdChangelog();
    case 'undo':      return cmdUndo();
    case 'verify':    return cmdVerify();
    case 'machine-lock': return cmdMachineLock();
    case 'doctor':    return cmdDoctor();
    case 'backup':    return cmdBackup();
    case 'restore':   return cmdRestore();
    case 'stats':     return cmdStats();
    case 'ssh-key':   return cmdSshKey();
    case 'dashboard': return cmdDashboard();
    case 'daemon':    return cmdDaemon();
    case 'token':     return cmdToken();
    case 'mcp':       return cmdMcp();
    case 'edit':      return cmdEdit();
    case 'purge-changelog': return cmdPurgeChangelog();
    case 'projects':  return cmdProjects();
    case 'expiring':  return cmdExpiring();
    case 'audit':     return cmdAudit();
    case 'access-log':return cmdAccessLog();
    case 'deploy':    return cmdDeploy();
    case 'which':
    case 'where':
    case 'home':      return cmdWhich();
    case 'help':
    case '--help':
    case '-h':
    case undefined:   return cmdHelp();
    default:
      process.stderr.write('Unknown command: ' + command + '\n');
      process.stderr.write('Run: credmgr help\n');
      process.exit(3);
  }
}

// ─── init ───────────────────────────────────────────────────────────────────

function cmdInit() {
  // A credential vault must never be created inside a git repository — one
  // `git add -A` publishes it. lib/paths.js keeps the default outside any repo;
  // this is the check for the case where someone points CREDMGR_HOME at one.
  const paths = require(path.join(LIB, 'paths'));
  try {
    const r = paths.assertVaultNotInRepo(cryptoLib.CRED_DIR, { strict: true });
    if (r && r.warning) console.error('\n WARNING\n' + r.warning + '\n');
  } catch (err) {
    process.stderr.write('\nREFUSING TO INITIALISE\n\n' + err.message + '\n\n');
    process.exit(4);
  }

  const keyPath = path.join(cryptoLib.CREDMGR_DIR, 'master.key');
  if (fs.existsSync(keyPath)) {
    console.log('credmgr already initialized. Master key exists at:', keyPath);
    const v = cryptoLib.verify();
    console.log('Verification:', v.ok ? 'PASS' : 'FAIL');
    if (!v.ok) v.errors.forEach(e => console.error('  -', e));
    return;
  }

  console.log('Generating new age keypair...');
  const { identityPath, publicKey } = cryptoLib.generateKeypair();
  console.log('Master key:  ', identityPath);
  console.log('Public key:  ', publicKey);

  // Write config
  const configPath = path.join(cryptoLib.CREDMGR_DIR, 'config.json');
  const config = {
    version: 1,
    keyPath: path.join(cryptoLib.CREDMGR_DIR, 'master.key'),
    pubKeyPath: path.join(cryptoLib.CREDMGR_DIR, 'master.pub'),
    changelogRetentionDays: 7,
    dashboardPort: 9876,
    autoClassify: true,
    credDir: cryptoLib.CRED_DIR,
  };
  fs.writeFileSync(configPath, JSON.stringify(config, null, 2) + '\n', { mode: 0o600 });

  // Initialize empty store
  const index = store.createEmptyIndex();
  store.saveIndex(index);
  store.saveVault({});

  console.log('Store initialized. Add your first credential with: credmgr set <NAME>');
}

// ─── get ────────────────────────────────────────────────────────────────────

function cmdGet() {
  const refNum = getFlag('ref');
  const name = refNum ? null : args[1];
  if (!name && !refNum) { process.stderr.write('Usage: credmgr get <name> [--json]\n       credmgr get --ref=<number> [--json]\n'); process.exit(3); }

  let result;
  if (refNum) {
    result = store.getByRef(parseInt(refNum, 10));
    if (!result) { process.stderr.write('Not found: ref #' + refNum + '\n'); process.exit(1); }
  } else {
    result = store.get(name);
    if (!result) { process.stderr.write('Not found: ' + name + '\n'); process.exit(1); }
  }

  if (hasFlag('json')) {
    console.log(JSON.stringify({ value: result.value, ...result.metadata }, null, 2));
  } else if (hasFlag('clipboard') || hasFlag('copy') || hasFlag('c')) {
    copyToClipboard(result.value);
    const secs = parseInt(getFlag('clear') || '30', 10);
    process.stderr.write('Copied ' + (result.metadata.name || '') + ' to clipboard');
    if (secs > 0) {
      scheduleClipboardClear(result.value, secs);
      process.stderr.write(' (auto-clears in ' + secs + 's)');
    }
    process.stderr.write('\n');
  } else {
    process.stdout.write(result.value);
    if (process.stdout.isTTY) process.stdout.write('\n');
  }
}

// Copy a value to the OS clipboard without it ever touching argv/stdout.
function copyToClipboard(value) {
  const { execFileSync } = require('child_process');
  const candidates = process.platform === 'darwin'
    ? [['pbcopy', []]]
    : [['wl-copy', []], ['xclip', ['-selection', 'clipboard']], ['xsel', ['--clipboard', '--input']]];
  for (const [bin, cmdArgs] of candidates) {
    try { execFileSync(bin, cmdArgs, { input: value }); return true; } catch (_) {}
  }
  process.stderr.write('No clipboard tool found (need pbcopy/wl-copy/xclip/xsel)\n');
  process.exit(1);
}

// Fork a detached process that clears the clipboard after `secs`, but only if it
// still holds our value (don't clobber whatever the user copied since).
function scheduleClipboardClear(value, secs) {
  const { spawn } = require('child_process');
  const isMac = process.platform === 'darwin';
  const readCmd = isMac ? 'pbpaste' : 'xclip -selection clipboard -o 2>/dev/null || xsel --clipboard 2>/dev/null';
  const writeCmd = isMac ? 'pbcopy' : 'wl-copy 2>/dev/null || xclip -selection clipboard || xsel --clipboard --input';
  const b64 = Buffer.from(value).toString('base64');
  const script = `sleep ${secs}; cur=$(${readCmd}); want=$(printf %s "${b64}" | base64 --decode); [ "$cur" = "$want" ] && printf '' | ${writeCmd}`;
  const child = spawn('sh', ['-c', script], { detached: true, stdio: 'ignore' });
  child.unref();
}

// ─── set ────────────────────────────────────────────────────────────────────

async function cmdSet() {
  const name = args[1];
  if (!name) { process.stderr.write('Usage: credmgr set <name> <value> [--project=X] [--category=X]\n'); process.exit(3); }

  let value;
  if (hasFlag('stdin')) {
    value = await readStdin();
  } else {
    value = args[2];
    if (!value) { process.stderr.write('Usage: credmgr set <name> <value>\n'); process.exit(3); }
  }

  const overrides = {};
  const project = getFlag('project');
  const category = getFlag('category');
  const tags = getFlag('tags');
  const description = getFlag('description');
  const notes = getFlag('notes');

  if (project) overrides.project = project;
  if (category) overrides.category = category;
  if (tags) overrides.tags = tags.split(',').map(t => t.trim());
  if (description) overrides.description = description;
  if (notes) overrides.notes = notes;

  const entry = store.set(name, value, Object.keys(overrides).length > 0 ? overrides : null);

  if (hasFlag('json')) {
    console.log(JSON.stringify(entry, null, 2));
  } else {
    const existed = entry.created !== entry.modified;
    console.log((existed ? 'Updated' : 'Added') + ': ' + name + ' [' + entry.project + '/' + entry.category + ']');
  }
}

// ─── rm ─────────────────────────────────────────────────────────────────────

function cmdRemove() {
  const name = args[1];
  if (!name) { process.stderr.write('Usage: credmgr rm <name>\n'); process.exit(3); }

  const removed = store.remove(name);
  if (!removed) { process.stderr.write('Not found: ' + name + '\n'); process.exit(1); }

  console.log('Removed: ' + name + ' (recoverable for 7 days via: credmgr changelog)');
}

// ─── list ───────────────────────────────────────────────────────────────────

function cmdList() {
  const filters = {};
  const project = getFlag('project');
  const category = getFlag('category');
  const tag = getFlag('tag');

  if (project) filters.project = project;
  if (category) filters.category = category;
  if (tag) filters.tag = tag;

  const results = store.list(Object.keys(filters).length > 0 ? filters : null);

  if (hasFlag('json')) {
    console.log(JSON.stringify(results, null, 2));
    return;
  }

  if (results.length === 0) {
    console.log('No credentials found.');
    return;
  }

  // Ensure refs exist
  store.ensureRefs(store.loadIndex());
  // Re-fetch with refs
  const freshResults = store.list(Object.keys(filters).length > 0 ? filters : null);

  // Group by project
  const grouped = {};
  for (const cred of freshResults) {
    if (!grouped[cred.project]) grouped[cred.project] = [];
    grouped[cred.project].push(cred);
  }

  for (const [proj, creds] of Object.entries(grouped).sort()) {
    console.log('\n  ' + proj.toUpperCase() + ' (' + creds.length + ')');
    console.log('  ' + '─'.repeat(56));
    for (const c of creds.sort((a, b) => a.name.localeCompare(b.name))) {
      const ref = '#' + String(c.ref || 0).padStart(3, '0');
      const sens = c.sensitivity === 'critical' ? '!!' : c.sensitivity === 'high' ? '! ' : '  ';
      console.log('  ' + ref + ' ' + sens + c.name.padEnd(38) + ' [' + c.category + ']');
    }
  }
  console.log('\n  Total: ' + freshResults.length + ' credentials\n');
}

// ─── search ─────────────────────────────────────────────────────────────────

function cmdSearch() {
  const query = args.slice(1).join(' ');
  if (!query) { process.stderr.write('Usage: credmgr search <query>\n'); process.exit(3); }

  const results = store.search(query);

  if (hasFlag('json')) {
    console.log(JSON.stringify(results, null, 2));
    return;
  }

  if (results.length === 0) {
    console.log('No results for: ' + query);
    return;
  }

  for (const c of results) {
    const tags = c.tags ? c.tags.join(', ') : '';
    console.log('  ' + c.name.padEnd(40) + ' [' + c.project + '/' + c.category + '] ' + tags);
  }
  console.log('\n  ' + results.length + ' result(s)');
}

// ─── show ───────────────────────────────────────────────────────────────────

function cmdShow() {
  const refNum = getFlag('ref');
  const name = refNum ? null : args[1];
  if (!name && !refNum) { process.stderr.write('Usage: credmgr show <name>\n       credmgr show --ref=<number>\n'); process.exit(3); }

  let meta;
  if (refNum) {
    const result = store.getByRef(parseInt(refNum, 10));
    meta = result ? result.metadata : null;
  } else {
    meta = store.getMetadata(name);
  }
  if (!meta) { process.stderr.write('Not found: ' + (name || 'ref #' + refNum) + '\n'); process.exit(1); }

  if (hasFlag('json')) {
    console.log(JSON.stringify(meta, null, 2));
  } else {
    console.log('  Ref:         #' + String(meta.ref || '—').padStart(3, '0'));
    console.log('  Name:        ' + meta.name);
    console.log('  Project:     ' + meta.project);
    console.log('  Category:    ' + meta.category);
    console.log('  Sensitivity: ' + meta.sensitivity);
    console.log('  Tags:        ' + (meta.tags || []).join(', '));
    console.log('  Format:      ' + meta.format);
    console.log('  Created:     ' + meta.created);
    console.log('  Modified:    ' + meta.modified);
    if (meta.rotated) console.log('  Rotated:     ' + meta.rotated);
    if (meta.expiresAt) console.log('  Expires:     ' + meta.expiresAt);
    if (meta.description) console.log('  Description: ' + meta.description);
    if (meta.notes) console.log('  Notes:       ' + meta.notes);
    if (meta.deployedTo && meta.deployedTo.length) console.log('  Deployed to: ' + meta.deployedTo.join(', '));
  }
}

// ─── export ─────────────────────────────────────────────────────────────────

function cmdExport() {
  const project = args[1];
  if (!project) { process.stderr.write('Usage: credmgr export <project> [--file] [--aliases]\n'); process.exit(3); }

  // --aliases: also write each entry's absorbed old names (both spellings),
  // so consumers still reading a pre-merge variable name keep working.
  const envContent = store.exportEnv(project, undefined, { includeAliases: hasFlag('aliases') });

  if (hasFlag('file')) {
    const outPath = path.join(cryptoLib.CRED_DIR, 'dev', project, '.env.credmgr');
    const dir = path.dirname(outPath);
    if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
    fs.writeFileSync(outPath, envContent, { mode: 0o600 });
    console.log('Written to: ' + outPath);
  } else {
    process.stdout.write(envContent);
  }
}

// ─── env (shell export format) ──────────────────────────────────────────────

function cmdEnv() {
  const project = args[1];
  if (!project) { process.stderr.write('Usage: credmgr env <project>\n'); process.exit(3); }

  const envContent = store.exportEnv(project);
  const lines = envContent.trim().split('\n').filter(l => l && !l.startsWith('#'));
  for (const line of lines) {
    process.stdout.write('export ' + line + '\n');
  }
}

// ─── rotate ─────────────────────────────────────────────────────────────────

async function cmdRotate() {
  const name = args[1];
  if (!name) { process.stderr.write('Usage: credmgr rotate <name> [<new-value>]\n'); process.exit(3); }

  let newValue = args[2];
  if (!newValue && process.stdin.isTTY) {
    newValue = await prompt('New value for ' + name + ': ');
  } else if (!newValue) {
    newValue = await readStdin();
  }

  const entry = store.rotate(name, newValue);
  if (!entry) { process.stderr.write('Not found: ' + name + '\n'); process.exit(1); }
  console.log('Rotated: ' + name + ' (old value in changelog for 7 days)');
}

// ─── generate ─────────────────────────────────────────────────────────────────

function cmdGenerate() {
  const length = parseInt(getFlag('length') || '32', 10);
  const type = getFlag('type') || 'password';
  const symbols = !hasFlag('no-symbols');
  const secret = store.generateSecret({ length, type, symbols });

  const name = args[1] && !args[1].startsWith('--') ? args[1] : null;
  if (name) {
    // Persist the generated secret under <name>, then confirm (never echo value).
    const overrides = {};
    const project = getFlag('project');
    const category = getFlag('category');
    if (project) overrides.project = project;
    if (category) overrides.category = category;
    store.set(name, secret, Object.keys(overrides).length ? overrides : null);
    if (hasFlag('clipboard') || hasFlag('copy')) {
      copyToClipboard(secret);
      scheduleClipboardClear(secret, parseInt(getFlag('clear') || '30', 10));
      console.log('Generated and stored: ' + name + ' (copied to clipboard, clears in 30s)');
    } else {
      console.log('Generated and stored: ' + name + ' (' + length + ' chars)');
    }
  } else if (hasFlag('clipboard') || hasFlag('copy')) {
    copyToClipboard(secret);
    scheduleClipboardClear(secret, parseInt(getFlag('clear') || '30', 10));
    process.stderr.write('Generated secret copied to clipboard (clears in 30s)\n');
  } else {
    process.stdout.write(secret);
    if (process.stdout.isTTY) process.stdout.write('\n');
  }
}

// ─── import (.env bulk import) ────────────────────────────────────────────────

async function cmdImport() {
  const file = args[1] && !args[1].startsWith('--') ? args[1] : null;
  let content;
  if (file) {
    if (!fs.existsSync(file)) { process.stderr.write('File not found: ' + file + '\n'); process.exit(1); }
    content = fs.readFileSync(file, 'utf8');
  } else {
    content = await readStdin();
  }

  const overrides = {};
  const project = getFlag('project');
  const category = getFlag('category');
  if (project) overrides.project = project;
  if (category) overrides.category = category;

  const report = store.importEnv(content, Object.keys(overrides).length ? overrides : null, undefined, { overwrite: hasFlag('overwrite') });

  console.log('Imported:  ' + report.imported);
  console.log('Skipped:   ' + report.skipped + ' (identical value already stored)');
  if (report.conflicts > 0) {
    console.log('Conflicts: ' + report.conflicts + ' (different value — not overwritten; use --overwrite)');
    console.log('  ' + report.names.conflicts.join(', '));
  }
  if (report.imported > 0) console.log('\n  ' + report.names.imported.join(', '));
}

// ─── batch (import many credentials, incl. multi-field wallet records) ───────

async function cmdBatch() {
  const file = args[1] && !args[1].startsWith('--') ? args[1] : null;
  let content;
  if (file) {
    if (!fs.existsSync(file)) { process.stderr.write('File not found: ' + file + '\n'); process.exit(1); }
    content = fs.readFileSync(file, 'utf8');
  } else {
    content = await readStdin();
  }

  let items;
  try {
    items = JSON.parse(content);
  } catch (e) {
    process.stderr.write('Batch input must be a JSON array of items.\n');
    process.stderr.write('Each item is ONE credential:\n');
    process.stderr.write('  { "name": "WALLET_A", "chain": "ethereum", "address": "0x…", "privateKey": "0x…", "seedPhrase": "…" }\n');
    process.stderr.write('  { "name": "SVC_X", "fields": [{"label":"apiKey","value":"…"}] }\n');
    process.stderr.write('  { "name": "FLAT", "value": "single-value" }\n');
    process.exit(3);
  }
  if (!Array.isArray(items)) { process.stderr.write('Batch input must be a JSON array.\n'); process.exit(3); }

  const report = store.batchImport(items, {
    batchGroup: getFlag('group') || undefined,
    overwrite: hasFlag('overwrite'),
    defaultProject: getFlag('project') || undefined,
  });

  if (hasFlag('json')) { console.log(JSON.stringify(report, null, 2)); return; }

  console.log('Batch group: ' + report.batchGroup);
  console.log('  Added:     ' + report.added);
  console.log('  Skipped:   ' + report.skipped + ' (identical value already stored)');
  if (report.conflicts > 0) {
    console.log('  Conflicts: ' + report.conflicts + ' (different value — use --overwrite)');
    console.log('    ' + report.conflictNames.join(', '));
  }
  if (report.errors > 0) {
    console.log('  Errors:    ' + report.errors);
    report.failures.forEach(f => console.log('    - ' + (f.name || '?') + ': ' + f.error));
  }
  if (report.added > 0) {
    console.log('\n  Created:');
    for (const r of report.results) {
      const detail = r.kind === 'flat' ? '[flat]' : '[' + r.kind + ', ' + r.fields + ' sub-fields]';
      console.log('    #' + String(r.ref).padStart(4, '0') + '  ' + r.name.padEnd(34) + detail);
    }
  }
}

// ─── history (per-credential version trail) ──────────────────────────────────

function cmdHistory() {
  const name = args[1];
  if (!name) { process.stderr.write('Usage: credmgr history <name>\n'); process.exit(3); }

  const rows = store.history(name);
  if (hasFlag('json')) { console.log(JSON.stringify(rows, null, 2)); return; }

  if (rows.length === 0) {
    console.log('No history for "' + name + '" (changelog retains 7 days).');
    return;
  }
  console.log('\n  History for ' + name);
  console.log('  ' + '═'.repeat(60));
  for (const r of rows) {
    const ts = r.timestamp.slice(0, 19).replace('T', ' ');
    const action = r.action.toUpperCase().padEnd(16);
    const actor = r.actor ? '  (' + r.actor + ')' : '';
    console.log('  ' + ts + '  ' + action + actor);
    console.log('        ' + r.changeId);
  }
  console.log('\n  ' + rows.length + ' change(s). Restore one with: credmgr undo <change-id>\n');
}

// ─── doctor (detect + repair store inconsistencies) ──────────────────────────

function cmdDoctor() {
  const apply = hasFlag('fix') || hasFlag('apply');
  console.log('Running store diagnostics...\n');

  const integ = store.verifyIntegrity();
  console.log('  Integrity:   ' + (integ.ok ? 'PASS' : 'FAIL') + '  (checksum: ' + integ.checksum + ')');
  integ.errors.forEach(e => console.log('    [error] ' + e));
  integ.warnings.forEach(w => console.log('    [warn]  ' + w));

  const heal = store.healStore(undefined, { apply });
  console.log('\n  ' + (apply ? 'Applied' : 'Would apply') + ' ' + heal.fixCount + ' fix(es):');
  if (heal.fixCount === 0) {
    console.log('    (nothing to repair)');
  } else {
    heal.fixes.forEach(f => console.log('    - [' + f.type + '] ' + f.detail));
  }

  if (!apply && heal.fixCount > 0) {
    console.log('\n  Re-run with --fix to apply these repairs.');
  }
  console.log('');
  if (integ.errors.length > 0 && !apply) process.exit(4);
}

// ─── backup / restore (portable encrypted snapshot) ──────────────────────────

function cmdBackup() {
  const result = store.backup({
    outPath: getFlag('out') || undefined,
    includeKey: hasFlag('include-key'),
    retain: getFlag('retain') || undefined,   // keep newest N (default 14); 0 = never prune
  });

  console.log('Backup written: ' + result.path);
  console.log('  Contents: ' + result.items.join(', '));
  if (result.pruned && result.pruned.length > 0) {
    console.log('  Pruned ' + result.pruned.length + ' old backup(s) beyond retain=' + result.retain +
      ': ' + result.pruned.join(', '));
  }
  if (!result.includeKey) {
    console.log('  NOTE: master key NOT included. Restore requires your existing ~/.credmgr/master.key.');
    console.log('        Use --include-key for a fully self-contained (more sensitive) backup.');
  } else {
    console.log('  WARNING: master key IS included — treat this file as critical-sensitivity.');
  }
}

function cmdRestore() {
  const file = args[1];
  if (!file) { process.stderr.write('Usage: credmgr restore <backup.tar.age> [--force]\n'); process.exit(3); }
  if (!fs.existsSync(file)) { process.stderr.write('Backup not found: ' + file + '\n'); process.exit(1); }

  const { execFileSync } = require('child_process');
  // Refuse to clobber a populated store unless --force.
  if (fs.existsSync(store.INDEX_PATH) && !hasFlag('force')) {
    const idx = store.loadIndex();
    if (idx.credentials && idx.credentials.length > 0) {
      process.stderr.write('Refusing to overwrite existing store (' + idx.credentials.length + ' credentials).\n');
      process.stderr.write('Re-run with --force to restore anyway (current store will be replaced).\n');
      process.exit(3);
    }
  }

  const tarBuf = cryptoLib.decryptFileToBuffer(file);
  const tmp = cryptoLib.secureTempFile('restore.tar', tarBuf);
  try {
    execFileSync('tar', ['-xf', tmp.file, '-C', cryptoLib.CRED_DIR]);
  } finally {
    cryptoLib.cleanupTemp(tmp.dir);
  }

  const v = store.verifyIntegrity();
  console.log('Restored from: ' + file);
  console.log('  Credentials: ' + v.credentialCount);
  console.log('  Integrity:   ' + (v.ok ? 'PASS' : 'FAIL (' + v.checksum + ')'));
  if (!v.ok) v.errors.forEach(e => console.log('    - ' + e));
}

// ─── changelog ──────────────────────────────────────────────────────────────

function cmdChangelog() {
  const changes = changelog.listChanges();

  if (hasFlag('json')) {
    // Strip values from JSON output for safety
    const safe = changes.map(c => ({
      ...c,
      previousValue: c.previousValue ? '[encrypted]' : null,
      newValue: c.newValue ? '[encrypted]' : null,
    }));
    console.log(JSON.stringify(safe, null, 2));
    return;
  }

  if (changes.length === 0) {
    console.log('No recent changes.');
    return;
  }

  for (const c of changes) {
    const ts = c.timestamp.slice(0, 19).replace('T', ' ');
    const action = c.action.toUpperCase().padEnd(16);
    console.log('  ' + ts + '  ' + action + c.credentialName + '  [' + c.changeId + ']');
  }
  console.log('\n  ' + changes.length + ' change(s). Use: credmgr undo <change-id>');
}

// ─── undo ───────────────────────────────────────────────────────────────────

function cmdUndo() {
  const changeId = args[1];
  if (!changeId) { process.stderr.write('Usage: credmgr undo <change-id> [--keep-both]\n'); process.exit(3); }

  const mode = hasFlag('keep-both') ? 'keep-both' : 'replace';
  const result = changelog.undo(changeId, null, { mode });
  if (result.success) {
    console.log(result.message);
  } else {
    process.stderr.write('Undo failed: ' + result.message + '\n');
    process.exit(1);
  }
}

// ─── verify ─────────────────────────────────────────────────────────────────

function cmdVerify() {
  console.log('Verifying encryption...');
  const cryptoResult = cryptoLib.verify();
  console.log('  Encryption:  ' + (cryptoResult.ok ? 'PASS' : 'FAIL'));
  if (!cryptoResult.ok) cryptoResult.errors.forEach(e => console.error('    -', e));

  console.log('Verifying store integrity...');
  const storeResult = store.verifyIntegrity();
  console.log('  Store:       ' + (storeResult.ok ? 'PASS' : 'FAIL'));
  console.log('  Checksum:    ' + storeResult.checksum);
  console.log('  Credentials: ' + storeResult.credentialCount);
  if (!storeResult.ok) storeResult.errors.forEach(e => console.error('    -', e));
  if (storeResult.warnings) storeResult.warnings.forEach(w => console.error('    (warn)', w));

  const ok = cryptoResult.ok && storeResult.ok;
  console.log('\nOverall: ' + (ok ? 'PASS' : 'FAIL'));
  if (!ok) process.exit(4);
}

// ─── machine-lock ───────────────────────────────────────────────────────────
// Binds the vault's age identity to THIS machine (see lib/machine-lock.js
// for the mechanism). Opt-in, off by default. `enable` runs a REAL encrypt/
// decrypt round-trip through age immediately after wrapping and rolls back
// automatically if it fails — this can never leave the vault stuck.

async function cmdMachineLock() {
  const machineLock = require(path.join(LIB, 'machine-lock'));
  const sub = args[1];

  if (sub === 'status') {
    console.log(JSON.stringify(machineLock.status({}), null, 2));
    return;
  }

  if (sub === 'enable') {
    if (machineLock.isEnabled({})) {
      console.log('Machine lock is already enabled.');
      return;
    }
    console.log(
      'This will bind the vault\'s master key to this machine\'s hardware/OS\n' +
      'identity. A copy of store/ + .credmgr/ taken elsewhere will refuse to\n' +
      'decrypt. You can undo this with `credmgr machine-lock disable` — but\n' +
      'only from THIS machine (that is the point).\n'
    );
    if (!hasFlag('yes')) {
      const answer = await prompt('Type "yes" to continue: ');
      if (answer.toLowerCase() !== 'yes') { console.log('Cancelled.'); return; }
    }
    const identityPath = cryptoLib.getIdentityPath({});
    machineLock.enable(identityPath, {});
    try {
      const probe = 'credmgr-machine-lock-verify-' + Date.now();
      const enc = cryptoLib.encrypt(probe, {});
      const dec = cryptoLib.decrypt(enc, {});
      if (dec.trim() !== probe) throw new Error('round-trip value mismatch');
      console.log('Machine lock enabled — this vault now only decrypts on this machine.');
    } catch (err) {
      // Never leave the user stuck: automatic rollback on any verification failure.
      try { machineLock.disable(identityPath, {}); } catch (_) { /* best-effort */ }
      console.error('Verification failed after enabling — rolled back automatically: ' + err.message);
      process.exit(1);
    }
    return;
  }

  if (sub === 'disable') {
    if (!machineLock.isEnabled({})) {
      console.log('Machine lock is not enabled.');
      return;
    }
    const identityPath = cryptoLib.getIdentityPath({});
    machineLock.disable(identityPath, {});
    console.log('Machine lock disabled — the identity is plaintext again.');
    return;
  }

  console.log('Usage: credmgr machine-lock <enable|disable|status> [--yes]');
}

// ─── stats ──────────────────────────────────────────────────────────────────

function cmdStats() {
  const s = store.stats();

  if (hasFlag('json')) {
    console.log(JSON.stringify(s, null, 2));
    return;
  }

  console.log('\n  Credential Store Statistics');
  console.log('  ' + '═'.repeat(40));
  console.log('  Total credentials: ' + s.total);
  console.log('  Projects:          ' + s.projectCount);
  console.log('  Last modified:     ' + s.lastModified);
  console.log('\n  By Project:');
  for (const [k, v] of Object.entries(s.byProject).sort((a, b) => b[1] - a[1])) {
    console.log('    ' + k.padEnd(25) + v);
  }
  console.log('\n  By Category:');
  for (const [k, v] of Object.entries(s.byCategory).sort((a, b) => b[1] - a[1])) {
    console.log('    ' + k.padEnd(25) + v);
  }
  console.log('\n  By Sensitivity:');
  for (const [k, v] of Object.entries(s.bySensitivity).sort()) {
    console.log('    ' + k.padEnd(25) + v);
  }
  console.log('');
}

// ─── ssh-key ────────────────────────────────────────────────────────────────

function cmdSshKey() {
  const name = args[1];
  if (!name) { process.stderr.write('Usage: credmgr ssh-key <name>\n'); process.exit(3); }

  const sshDir = path.join(cryptoLib.CRED_DIR, 'ssh');
  const ageFile = path.join(sshDir, name + '.age');

  if (!fs.existsSync(ageFile)) {
    process.stderr.write('SSH key not found: ' + ageFile + '\n');
    process.exit(1);
  }

  const plaintext = cryptoLib.decryptFile(ageFile);

  // Write to an unpredictable 0700 temp dir (no symlink-race window).
  const tmp = cryptoLib.secureTempFile(name, plaintext);
  console.log(tmp.file);
}

// ─── dashboard ──────────────────────────────────────────────────────────────

function cmdDashboard() {
  const server = require(path.join(LIB, 'server'));
  const port = parseInt(getFlag('port') || '9876', 10);
  server.start(port, {});
}

// ─── daemon (headless HTTP API, for other projects to consume) ──────────────

function cmdDaemon() {
  const server = require(path.join(LIB, 'server'));
  const port = parseInt(getFlag('port') || '9876', 10);
  const bind = getFlag('bind') || '127.0.0.1';

  // CORS: --cors (localhost-only allowlist) OR --cors-origin=<url> (explicit).
  // --cors-origin may be passed multiple times.
  const corsOrigins = [];
  for (const a of args) {
    if (a.startsWith('--cors-origin=')) corsOrigins.push(a.slice('--cors-origin='.length));
  }
  let allowCors;
  if (corsOrigins.length > 0) allowCors = corsOrigins;
  else if (hasFlag('cors')) allowCors = true;
  else allowCors = false;

  // Resolve token: explicit --token flag > CREDMGR_TOKEN env > saved token file
  let token = getFlag('token') || process.env.CREDMGR_TOKEN || null;
  let tokenSource = token ? 'explicit' : null;
  const daemonTokenPath = savedTokenPath();
  if (!token) {
    const saved = readSavedToken();
    if (saved) { token = saved; tokenSource = 'saved'; }
  }
  // Safety: refuse non-localhost bind without a token.
  if (bind !== '127.0.0.1' && !token) {
    process.stderr.write('Refusing to bind to ' + bind + ' without a token.\n');
    process.stderr.write('Run: credmgr token generate   (then retry)\n');
    process.exit(3);
  }

  server.start(port, { bind, token, tokenSource, daemonTokenPath, allowCors, headless: true });
}

// ─── token (manage daemon auth token) ──────────────────────────────────────

function cmdToken() {
  const sub = args[1];
  const tokenFile = savedTokenPath();

  switch (sub) {
    case 'generate': case 'new': case 'rotate': {
      const nodeCrypto = require('crypto');
      const token = nodeCrypto.randomBytes(32).toString('hex');
      fs.mkdirSync(path.dirname(tokenFile), { recursive: true, mode: 0o700 });
      fs.writeFileSync(tokenFile, token, { mode: 0o600 });
      process.stdout.write(token + '\n');
      process.stderr.write('\nSaved to: ' + tokenFile + '\n');
      process.stderr.write('Export to your shell:  export CREDMGR_TOKEN=' + token + '\n');
      return;
    }
    case 'show': case 'print': {
      const t = readSavedToken();
      if (!t) { process.stderr.write('No token saved. Run: credmgr token generate\n'); process.exit(1); }
      process.stdout.write(t + '\n');
      return;
    }
    case 'revoke': case 'clear': {
      if (fs.existsSync(tokenFile)) fs.unlinkSync(tokenFile);
      process.stderr.write('Token revoked.\n');
      return;
    }
    case 'path': {
      process.stdout.write(tokenFile + '\n');
      return;
    }
    default:
      process.stderr.write('Usage: credmgr token <generate|show|revoke|path>\n');
      process.exit(3);
  }
}

function readSavedToken() {
  try {
    const p = savedTokenPath();
    if (!fs.existsSync(p)) return null;
    return fs.readFileSync(p, 'utf8').trim() || null;
  } catch { return null; }
}

function savedTokenPath() {
  const current = store.daemonTokenPath();
  // Portable/test vaults must never consult another user's default token.
  if (process.env.CREDMGR_HOME || fs.existsSync(current)) return current;
  // Keep existing default installs using their legacy saved-token location
  // until they replace it; the daemon checks/rotates that same selected file.
  const legacy = path.join(require('os').homedir(), '.credmgr', 'daemon.token');
  return fs.existsSync(legacy) ? legacy : current;
}

// ─── mcp (Model Context Protocol server for AI agents) ─────────────────────

function cmdMcp() {
  const mcp = require(path.join(__dirname, '..', 'mcp', 'server'));
  mcp.run();
}

// ─── edit ───────────────────────────────────────────────────────────────────

async function cmdEdit() {
  const name = args[1];
  if (!name) { process.stderr.write('Usage: credmgr edit <name>\n'); process.exit(3); }

  const meta = store.getMetadata(name);
  if (!meta) { process.stderr.write('Not found: ' + name + '\n'); process.exit(1); }

  console.log('Editing metadata for: ' + name);
  console.log('Press Enter to keep current value.\n');

  const updates = {};
  const newProject = await prompt('  Project [' + meta.project + ']: ');
  if (newProject) updates.project = newProject;

  const newCategory = await prompt('  Category [' + meta.category + ']: ');
  if (newCategory) updates.category = newCategory;

  const newTags = await prompt('  Tags [' + (meta.tags || []).join(', ') + ']: ');
  if (newTags) updates.tags = newTags.split(',').map(t => t.trim());

  const newDesc = await prompt('  Description [' + (meta.description || '') + ']: ');
  if (newDesc) updates.description = newDesc;

  const newNotes = await prompt('  Notes [' + (meta.notes || '') + ']: ');
  if (newNotes) updates.notes = newNotes;

  if (Object.keys(updates).length > 0) {
    store.updateMetadata(name, updates);
    console.log('\nUpdated: ' + name);
  } else {
    console.log('\nNo changes.');
  }
}

// ─── purge-changelog ────────────────────────────────────────────────────────

function cmdPurgeChangelog() {
  const count = changelog.forcePurge();
  console.log('Purged ' + count + ' expired changelog entries.');
}

// ─── projects ───────────────────────────────────────────────────────────────

function cmdProjects() {
  const sub = args[1];

  if (sub === 'remove' || sub === 'rm') {
    const projectId = args[2];
    if (!projectId) { process.stderr.write('Usage: credmgr projects remove <projectId>\n'); process.exit(3); }
    try {
      const result = store.removeProject(projectId);
      console.log('Removed project: ' + result.name + ' (' + result.projectId + ') — no longer selectable for tagging.');
    } catch (err) {
      process.stderr.write('Error: ' + err.message + '\n');
      process.exit(1);
    }
    return;
  }

  const projects = store.listProjects();

  if (hasFlag('json')) {
    console.log(JSON.stringify(projects, null, 2));
    return;
  }

  for (const p of projects) {
    const user = p.vpsUser ? ' (' + p.vpsUser + '@vps)' : '';
    console.log('  ' + p.id.padEnd(25) + p.name + user);
  }
}

// ─── which ──────────────────────────────────────────────────────────────────

function cmdWhich() {
  const paths = require(path.join(LIB, 'paths'));
  const pinfo = paths.paths();
  const gitRoot = paths.findGitRoot(cryptoLib.CRED_DIR);
  const info = {
    home: cryptoLib.CRED_DIR,
    platformDefault: pinfo.platformDefault,
    source: pinfo.isExplicit ? 'CREDMGR_HOME' : (pinfo.isLegacyInRepo ? 'legacy in-repo install' : 'platform default'),
    insideGitRepo: gitRoot || null,
    store: path.join(cryptoLib.CRED_DIR, 'store'),
    vault: path.join(cryptoLib.CRED_DIR, 'store', 'vault.age'),
    identity: path.join(cryptoLib.CREDMGR_DIR, 'master.key'),
    node: process.execPath,
    version: require(path.join(__dirname, '..', 'package.json')).version,
  };

  if (hasFlag('json')) {
    console.log(JSON.stringify(info, null, 2));
  } else {
    console.log('  Home:      ' + info.home + '   (' + info.source + ')');
    console.log('  Default:   ' + info.platformDefault);
    console.log('  Store:     ' + info.store);
    console.log('  Vault:     ' + info.vault);
    console.log('  Identity:  ' + info.identity);
    console.log('  Node:      ' + info.node);
    console.log('  Version:   ' + info.version);
    if (info.insideGitRepo) {
      console.log('');
      console.log('  ⚠  THIS VAULT IS INSIDE A GIT REPOSITORY: ' + info.insideGitRepo);
      console.log('     Move it before you ever push. Suggested:');
      console.log('       export CREDMGR_HOME="' + info.platformDefault + '"');
    }
  }
}

// ─── expiring ──────────────────────────────────────────────────────────────

function cmdExpiring() {
  const days = parseInt(getFlag('days') || '7', 10);
  const results = store.expiring(days);

  if (hasFlag('json')) {
    console.log(JSON.stringify(results, null, 2));
    return;
  }

  if (results.length === 0) {
    console.log('No credentials expiring within ' + days + ' days.');
    return;
  }

  console.log('\n  Expiring Credentials (within ' + days + ' days)');
  console.log('  ' + '═'.repeat(50));
  for (const c of results) {
    const status = c.expired ? '  EXPIRED' : '  ' + c.daysLeft + 'd left';
    const flag = c.expired ? '!!' : '! ';
    console.log('  ' + flag + c.name.padEnd(38) + status + '  [' + c.project + ']');
  }
  console.log('\n  ' + results.length + ' credential(s)\n');
}

// ─── audit ─────────────────────────────────────────────────────────────────

function cmdAudit() {
  const result = store.audit();

  if (hasFlag('json')) {
    console.log(JSON.stringify(result, null, 2));
    return;
  }

  console.log('\n  Credential Health Audit');
  console.log('  ' + '═'.repeat(50));
  console.log('  Total credentials: ' + result.total);
  console.log('  Issues found:      ' + result.issueCount);

  if (result.issues.length > 0) {
    const byType = {};
    for (const issue of result.issues) {
      if (!byType[issue.type]) byType[issue.type] = [];
      byType[issue.type].push(issue);
    }

    for (const [type, issues] of Object.entries(byType)) {
      const sev = issues[0].severity.toUpperCase();
      console.log('\n  [' + sev + '] ' + type.replace(/-/g, ' ') + ' (' + issues.length + ')');
      console.log('  ' + '─'.repeat(50));
      for (const i of issues.slice(0, 10)) {
        console.log('    ' + i.name.padEnd(38) + i.message);
      }
      if (issues.length > 10) console.log('    ... and ' + (issues.length - 10) + ' more');
    }
  }
  console.log('');
}

// ─── access-log ────────────────────────────────────────────────────────────

function cmdAccessLog() {
  // --purge: empty the access log (it's plaintext-0600 metadata — names an
  // attacker with disk access already has via index.json — but operators may
  // still want to cap what it accumulates).
  if (hasFlag('purge')) {
    const n = store.purgeAccessLog();
    console.log('Access log purged (' + n + ' record(s) removed).');
    return;
  }
  const filters = {};
  const name = getFlag('name');
  const source = getFlag('source');
  const limit = getFlag('limit');
  if (name) filters.name = name;
  if (source) filters.source = source;
  filters.limit = limit ? parseInt(limit, 10) : 50;

  const log = store.getAccessLog(filters);

  if (hasFlag('json')) {
    console.log(JSON.stringify(log, null, 2));
    return;
  }

  if (log.length === 0) {
    console.log('No access records found.');
    return;
  }

  console.log('\n  Recent Access Log');
  console.log('  ' + '═'.repeat(60));
  for (const entry of log) {
    const ts = entry.ts.slice(0, 19).replace('T', ' ');
    const src = entry.source.padEnd(10);
    console.log('  ' + ts + '  ' + src + entry.name);
  }
  console.log('\n  ' + log.length + ' record(s)\n');
}

// ─── deploy ────────────────────────────────────────────────────────────────

function cmdDeploy() {
  const project = args[1];
  const target = getFlag('target');
  if (!project) {
    process.stderr.write('Usage: credmgr deploy <project> --target=<user@host:/path>\n');
    process.stderr.write('       credmgr deploy <project> --target=<ssh-alias>  (uses project deploy config)\n');
    process.exit(3);
  }

  const envContent = store.exportEnv(project);
  if (!envContent.trim()) {
    process.stderr.write('No credentials found for project: ' + project + '\n');
    process.exit(1);
  }

  // Find project config for deploy path
  const projects = store.listProjects();
  const projConfig = projects.find(p => p.id === project);

  let remoteTarget;
  if (target) {
    remoteTarget = target;
  } else if (projConfig && projConfig.sshAlias && projConfig.deployPath) {
    remoteTarget = projConfig.sshAlias + ':' + projConfig.deployPath + '/.env';
  } else {
    process.stderr.write('No --target specified and no deploy config for project: ' + project + '\n');
    process.stderr.write('Set deploy path via dashboard or pass --target=user@host:/path/.env\n');
    process.exit(3);
  }

  // Write to an unpredictable 0700 temp dir; guaranteed cleanup in finally.
  const tmp = cryptoLib.secureTempFile(project + '.env', envContent);

  console.log('Deploying ' + project + ' env to: ' + remoteTarget);

  try {
    const { execFileSync } = require('child_process');
    execFileSync('scp', ['-q', tmp.file, remoteTarget], { stdio: 'inherit' });
    console.log('Deployed successfully.');
  } catch (err) {
    process.stderr.write('SCP failed. Ensure SSH key is available.\n');
    process.stderr.write('Hint: Use credmgr ssh-key <name> to get a decrypted key path.\n');
    process.exit(1);
  } finally {
    cryptoLib.cleanupTemp(tmp.dir);
  }
}

