<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd user agent for credmgrd, the CredMgr V2 broker.

  Install (see RELEASE.md): copy credmgrd to /usr/local/bin (or edit the path below), then
    cp com.credmgr.brokerd.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.credmgr.brokerd.plist

  Standard output and error go to /dev/null (ADR-159 amendment): launchd never rotates a log
  file, and the broker's start-up lines are name-free but still uncapped. The record is the
  broker's own diagnostic log (CREDMGR_DIAG_LOG=1, rotated at 1 MiB, name-free; see
  `credmgr status --log`). The broker prints no path, name or secret.

  KeepAlive restarts the broker if it exits. A restart locks the vault; unlock again with
  `credmgr unlock`.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.credmgr.brokerd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/credmgrd</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
