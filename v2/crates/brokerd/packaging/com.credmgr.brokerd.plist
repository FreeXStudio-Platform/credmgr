<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Reference launchd user agent for `credmgrd` (02_ARCHITECTURE.md §2). Refreshed 2026-11-20.

  The CredMgr desktop app writes this agent itself (Settings, Security, "Start the broker at
  login"), with the daemon bundled inside the app and named by absolute path (ADR-156, ADR-157);
  this file is the reference for what it writes, not something to install by hand with the app.
  For a command-line install without the app, `v2/packaging/com.credmgr.brokerd.plist` in the
  release package is the copy to use (it names /usr/local/bin/credmgrd).

  Per-user, never root: the broker's own uid-only peer gate (02_ARCHITECTURE.md §3) means a broker
  running as any other user could not be reached by its owner's clients anyway.

  Standard output and error go to /dev/null (ADR-159 amendment): launchd never rotates a log file,
  and the broker's start-up lines are name-free but still uncapped. The record is the broker's own
  diagnostic log (CREDMGR_DIAG_LOG=1, rotated at 1 MiB, name-free; `credmgr status --log`).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.credmgr.brokerd</string>

    <!-- The app uses the credmgrd inside CredMgr.app and writes its absolute path here. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/CredMgr.app/Contents/MacOS/credmgrd</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/dev/null</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
